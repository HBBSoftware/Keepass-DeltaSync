# Route alle requests til index.php hvis der ikke findes en konkret fil/dir.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bevar Authorization-headeren — nogle FastCGI-opsætninger stripper den ellers.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# Skjul dotfiles (sikkerhed: forhindrer adgang til evt. .env, .git osv.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Forbyd direkte adgang til bootstrap.php og config-mappen, hvis de skulle ende i public/ ved et uheld.
<FilesMatch "(?i)^(bootstrap\.php|composer\.(json|lock))$">
    Require all denied
</FilesMatch>

# Caching. Uden dette sender serveren kun en ETag, og browseren gætter selv en
# levetid ud fra hvor længe siden filen sidst blev ændret. Gættet var grunden
# til at en rettelse i style.css ikke kunne ses på en telefon der havde besøgt
# siden før — adressen var uændret, så browseren spurgte aldrig igen.
<IfModule mod_headers.c>
    # Sider og stilark: spørg altid serveren. Sammen med ETag koster det et
    # tomt 304-svar når filen er uændret, og en rettelse slår igennem straks.
    <FilesMatch "\.(html|css|js)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>

    # Billeder, ikoner og skrifttyper skifter kun ved at få et nyt filnavn,
    # så de må gerne blive liggende i browseren en uge.
    <FilesMatch "\.(png|jpe?g|gif|svg|webp|ico|woff2?)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>
