# Kopier denne fil til .env og udfyld værdierne.
# .env må aldrig committes — se .gitignore.

# --- Database (PostgreSQL 14+) ---
DATABASE_URL=pgsql:host=localhost;port=5432;dbname=keepass_deltasync
DATABASE_USER=keepass_username
DATABASE_PASSWORD=ChangeMe

# --- Admin-login til browser-panelet (valgfrit) ---
# Brugernavn + adgangskode til /admin.html. Adgangskoden hashes med Argon2id
# (parametrene nedenfor). Mindst 12 tegn. Sættes begge, eller ingen af dem.
# ADMIN_PASSWORD_FILE kan bruges i stedet, hvis kodeordet kommer fra en secret.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Hvor længe en session i panelet lever. Glidende: fornyes ved aktivitet.
ADMIN_SESSION_TTL_HOURS=8

# --- Reverse proxy ---
# Komma-separeret liste af IP'er/CIDR'er hvis X-Forwarded-Proto og
# X-Forwarded-For vi stoler på. Tom = ingen. Uden den her kan enhver klient
# forfalske de headere, så session-cookien kun får Secure-flaget når vi selv
# kan se at forbindelsen er HTTPS.
TRUSTED_PROXIES=

# --- Admin-token (valgfrit) ---
# Bestem selv admin-tokenet i stedet for at læse det ud af container-loggen ved
# første start. Mindst 24 tegn. Generér et med:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# Tomt = serveren laver selv et og printer det én gang. ADMIN_TOKEN_FILE kan
# bruges i stedet, hvis tokenet kommer fra en Docker-secret.
ADMIN_TOKEN=

# --- Logging ---
# INFO  = drift (auth-hændelser, enrollment, admin-handlinger)
# DEBUG = udvikling (alle API-kald inkl. GET /changes)
LOG_LEVEL=INFO

# --- Audit-cleanup ---
# Audit-log slettes efter dette antal dage. Trigget ved opstart, throttled til 1×/time.
AUDIT_RETENTION_DAYS=30

# --- Argon2id token-hashing parametre ---
# Juster efter serverkapacitet. Defaults er fornuftige for en lille VPS.
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=4
ARGON2_THREADS=1

# --- Rate limiting ---
# Fejlede auth-forsøg pr. IP pr. minut før midlertidig block.
RATE_LIMIT_AUTH_PER_MINUTE=10

# --- Enrollment ---
# Hvor længe en enrollment-token er gyldig (timer).
ENROLLMENT_TOKEN_TTL_HOURS=24

# --- Path prefix (valgfri) ---
# Hvis serveren deployes under en under-sti — fx for at dele subdomæne med en
# hjemmeside — sæt prefix'et her uden trailing slash. Klienter peger så deres
# server-URL til 'https://host{APP_BASE_PATH}'. Tom = serveret på roden.
# Eksempel: APP_BASE_PATH=/sync
APP_BASE_PATH=
