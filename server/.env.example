# Kopier denne fil til .env og udfyld værdierne.
# .env må aldrig committes — se .gitignore.

# --- Database (PostgreSQL 14+) ---
DATABASE_URL=pgsql:host=localhost;port=5432;dbname=keepass_deltasync
DATABASE_USER=keepass_username
DATABASE_PASSWORD=ChangeMe

# --- Logging ---
# INFO  = drift (auth-hændelser, enrollment, admin-handlinger)
# DEBUG = udvikling (alle API-kald inkl. GET /changes)
LOG_LEVEL=INFO

# --- Audit-cleanup ---
# Audit-log slettes efter dette antal dage. Trigget ved opstart, throttled til 1×/time.
AUDIT_RETENTION_DAYS=30

# --- Argon2id token-hashing parametre ---
# Juster efter serverkapacitet. Defaults er fornuftige for en lille VPS.
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=4
ARGON2_THREADS=1

# --- Rate limiting ---
# Fejlede auth-forsøg pr. IP pr. minut før midlertidig block.
RATE_LIMIT_AUTH_PER_MINUTE=10

# --- Enrollment ---
# Hvor længe en enrollment-token er gyldig (timer).
ENROLLMENT_TOKEN_TTL_HOURS=24
