{
    "name": "keepass-deltasync/server",
    "description": "Sync server for the KeePass delta-sync system. Sees only client-encrypted blobs.",
    "license": "AGPL-3.0-or-later",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "ext-json": "*",
        "ext-sodium": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "KeePassDeltaSync\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KeePassDeltaSync\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/admin"
    ],
    "config": {
        "sort-packages": true
    }
}
