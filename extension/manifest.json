{
  "manifest_version": 3,
  "name": "DeltaSync — KeePass search & go",
  "version": "0.2.0",
  "description": "Search your KeePass entries and open their website. Filling in credentials stays with KeePassXC-Browser.",

  "browser_specific_settings": {
    "gecko": {
      "id": "keepass-deltasync@hb-b.dk",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "permissions": ["nativeMessaging", "storage"],

  "background": {
    "scripts": ["search.js", "background.js"]
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Search KeePass entries",
    "default_icon": "icon.svg"
  },

  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },

  "omnibox": {
    "keyword": "kp"
  },

  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Search KeePass entries"
    }
  }
}
