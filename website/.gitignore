# collect_stats.py generates its dashboard into website/<STATS_PATH>/ at CI time.
# The directory name is the only thing making the page private, and this repo is
# public — so neither the directory nor its name belongs in git.
stats-*/

# de/, fr/ and es/ are generated from the English pages by i18n.py, and rebuilt
# in CI before every deploy. Committing them would let a generated copy drift
# from its source — the exact failure this setup exists to prevent. The
# translations themselves live in i18n/*.json, which IS tracked.
/de/
/fr/
/es/

__pycache__/

# px.php genereres af collect_stats.py med rapport-tokenet i sig.
px.php
