# Docker Compose environment for the DeltaSync server.
# Copy to .env (in this repo root) and fill in the values.  .env is gitignored.
#
#   cp .env.example .env
#   docker compose up -d --build

# --- REQUIRED ---------------------------------------------------------------
# Password for the PostgreSQL "deltasync" role. Use a long random string.
DB_PASSWORD=change-me-to-a-long-random-string

# --- Optional (defaults shown) ----------------------------------------------
# Host port the app is published on -> http://localhost:8080
HOST_PORT=8080

# INFO = production (auth/enrollment/admin events). DEBUG = all API calls.
LOG_LEVEL=INFO

# Audit-log rows are deleted after this many days.
AUDIT_RETENTION_DAYS=30

# How long an enrollment token stays valid (hours).
ENROLLMENT_TOKEN_TTL_HOURS=24

# Argon2id token-hashing cost. Defaults suit a small VPS.
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=4
ARGON2_THREADS=1

# Failed auth attempts per IP per minute before a temporary block.
RATE_LIMIT_AUTH_PER_MINUTE=10

# Serve the API under a sub-path (e.g. /sync). Empty = served at root.
APP_BASE_PATH=
