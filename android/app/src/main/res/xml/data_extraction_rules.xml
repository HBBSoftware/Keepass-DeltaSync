<?xml version="1.0" encoding="utf-8"?>
<!--
   Data-extraction-regler: device-credentials, .kdbx-filer og sync-state
   må IKKE backuppes til Google Drive eller D2D-overføres. Det er
   security-sensitivt og tabet kompenseres via re-enrollment.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
